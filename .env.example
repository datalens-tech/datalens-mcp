# Installation: cloud (default) or internal
DATALENS_INSTALLATION=cloud

# Cloud organization id (required in cloud mode)
DATALENS_ORG_ID=your-org-id

# DataLens API URL (default: https://api.datalens.tech; required for internal mode)
# DATALENS_API_URL=https://datalens.example

# Use a static cloud credential instead of the yc CLI
# DATALENS_YC_STATIC_AUTH=1
# DATALENS_API_AUTH_HEADER=Bearer your-token

# yc CLI settings for dynamic cloud IAM tokens
# DATALENS_YC_PROFILE=my-profile
# DATALENS_YC_BIN=yc

# OpenAPI sources. A local path takes precedence over the remote URL.
# DATALENS_SCHEMA_URL=https://api.datalens.tech/json/
# DATALENS_SCHEMA_PATH=/absolute/path/to/openapi.json
# DATALENS_SCHEMA_CACHE_PATH=/absolute/path/to/openapi-cache.json

# API headers and timeout
DATALENS_API_VERSION=latest
DATALENS_REQUEST_TIMEOUT_MS=30000

# Write policy: direct, planned (default), or disabled
DATALENS_MCP_WRITE_MODE=planned
# DATALENS_MCP_ALLOW_DESTRUCTIVE=1
# DATALENS_MCP_ALLOW_COMMANDS=getWorkbook,updateWorkbook
# DATALENS_MCP_DENY_COMMANDS=deleteWorkbook

# Large-result handling
DATALENS_MAX_RESPONSE_CHARS=100000
DATALENS_RESULT_TTL_MS=600000
DATALENS_RESULT_MAX_BYTES=10485760
DATALENS_RESULT_STORE_MAX_BYTES=52428800

# Prepared write plans
DATALENS_PLAN_TTL_MS=300000
