# Native DataLens Enterprise installation (not IAM/Stackland).
DATALENS_INSTALLATION=enterprise

# Installation base URL, without /rpc or the Swagger path.
DATALENS_API_URL=https://datalens.example.com

# JSON key downloaded from the service account UI.
# Keep the key outside the repository; restart MCP after rotating it.
DATALENS_SERVICE_ACCOUNT_KEY_FILE=/absolute/path/sa-key.json

# Alternative: remove DATALENS_SERVICE_ACCOUNT_KEY_FILE above and use a static
# native access token. Static tokens are not renewed automatically.
# DATALENS_API_AUTH_HEADER=Bearer <native-access-token>

# Optional: API version (default: latest).
# DATALENS_API_VERSION=latest

# Optional: override the automatically selected Enterprise OpenAPI URL.
# With a pinned API version, the default includes /swagger/{version}/json/.
# DATALENS_SCHEMA_URL=https://datalens.example.com/api/docs/swagger/json/

# Optional: maximum response characters forwarded to the MCP client.
# DATALENS_MAX_RESPONSE_CHARS=100000

# Optional: corporate CA certificate. Set before launching Node.
# NODE_EXTRA_CA_CERTS=/absolute/path/corporate-ca.pem
